{
  "name": "@hardlic/dsh-fitness-panel",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "Fitness dashboard for dsh-fitness v0.2: week strip with streak, timeline check-off, quick log, stats and advice. Left-rail Web panel, local SQLite.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hardlic/dsh-fitness.git",
    "directory": "ui"
  }
}
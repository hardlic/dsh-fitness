{
  "name": "@cildr/dsh-fitness-panel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only fitness dashboard for dsh-fitness: left-rail panel showing today's plan, sets, weekly stats and history from its SQLite store.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cildr/dsh-fitness.git",
    "directory": "ui"
  }
}